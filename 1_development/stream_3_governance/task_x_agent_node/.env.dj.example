# Copy this file to .env.dj (same folder). Never commit .env.dj.
# Discord: Developer Mode on, right-click server / channels, Copy ID.

DISCORD_DJ_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=

# YouTube or YouTube Music playlist (must include list=...)
YOUTUBE_PLAYLIST_URL=

# Optional: paired text channel (e.g. Friday's Pub chat) for "now playing" lines
# DISCORD_TEXT_CHANNEL_ID=
# DISCORD_ANNOUNCE_NOW_PLAYING=false

# Optional: path to a youtube.com cookies.txt file (Netscape format, exported from browser)
# Needed if tracks fail with "Invalid URL" — YouTube blocks unauthenticated stream requests.
# YOUTUBE_COOKIE_FILE=C:\path\to\yt-cookies.txt

# Optional: shuffle after each full pass through the playlist
# DJ_SHUFFLE_PLAYLIST=false
